        },
        {
          "refId": "C",
          "expr": "pegasus_running_instances{job=\"ruby_acorn_pegasus\",appid=\"730\"}",
          "legendFormat": "{{model}} {{horizon_minutes}}m {{evaluation}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
