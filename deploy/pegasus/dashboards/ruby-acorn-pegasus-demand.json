{
  "uid": "ruby-acorn-pegasus-demand",
  "title": "Ruby Acorn Pegasus \u2014 Game demand",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "ruby-acorn",
    "pegasus"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "description": "Observed Pegasus infrastructure and source exporter counts. Player capacity, customer share and EUR costs are prototype estimates. Source counts may be historical replay. Stopped root disks remain allocated; running-cost estimates exclude storage and management/monitoring.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "appid",
        "label": "Game",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(steam_player_count{job=\"games\"}, appid)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "730",
          "value": "730"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Game demand",
      "url": "/d/ruby-acorn-pegasus-demand",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Autoscaling behavior",
      "url": "/d/ruby-acorn-pegasus-scaling",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Cost and reliability",
      "url": "/d/ruby-acorn-pegasus-costs",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Observed source player count",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "steam_player_count{job=\"games\",appid=~\"$appid\"}",
          "legendFormat": "{{appid}} {{name}} {{strategy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Average source player count (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(steam_player_count{job=\"games\",appid=~\"$appid\"}[1h])",
          "legendFormat": "{{appid}} {{name}} {{strategy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Peak source player count (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(steam_player_count{job=\"games\",appid=~\"$appid\"}[1h])",
          "legendFormat": "{{appid}} {{name}} {{strategy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Source scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"games\"}",
          "legendFormat": "{{appid}} {{name}} {{strategy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Simulated customer demand (configured share)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "customer_player_count{job=\"ruby_acorn_pegasus\",appid=~\"$appid\"}",
          "legendFormat": "{{appid}} {{name}} {{strategy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Input available (fresh scrape)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "input_available{job=\"ruby_acorn_pegasus\",appid=~\"$appid\"}",
          "legendFormat": "{{appid}} {{name}} {{strategy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
