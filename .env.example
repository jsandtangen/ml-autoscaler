# Docker Compose reads .env automatically. Python main.py does not.
PROMETHEUS_IMAGE=prom/prometheus:v3.7.0
PROMETHEUS_PORT=9090
GRAFANA_IMAGE=grafana/grafana:12.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Use the Compose service name from inside the autoscaler container.
# For Python running on the host, use http://127.0.0.1:9090 instead.
PROMETHEUS_URL=http://prometheus:9090
AUTOSCALER_INTERVAL_SECONDS=30
# Prototype capacity assumptions, shared with shadow mode (not measured server capacity).
AUTOSCALER_STRATEGY=reactive_capacity
AUTOSCALER_PLAYER_SHARE=0.001
AUTOSCALER_PLAYERS_PER_INSTANCE=100
AUTOSCALER_HEADROOM_FRACTION=0.10
AUTOSCALER_MINIMUM_INSTANCES=1
AUTOSCALER_MAX_INSTANCES=7
AUTOSCALER_MAX_SCALING_CHANGE=2
AUTOSCALER_MAX_SAMPLE_AGE_SECONDS=90
# Host loop optional read-only offline comparison (Compose uses /app/data/scaling-comparison.json).
# AUTOSCALER_SIMULATION_REPORT_PATH=data/scaling-comparison.json
# Optional per-game TOML configuration. Overrides strategy and appid per game.
# The example file is mounted at this path by Compose.
# AUTOSCALER_GAMES_CONFIG=/app/games.example.toml
AUTOSCALER_METRIC_NAME=steam_player_count
AUTOSCALER_LABELS=appid=730
AUTOSCALER_METRICS_PORT=8001
# Illustrative EUR per VM-hour and fixed VM baseline per game.
AUTOSCALER_VM_COST_PER_HOUR=0.10
AUTOSCALER_FIXED_BASELINE_INSTANCES=4
# Append successful player-count observations as timestamp,appid,player_count.
AUTOSCALER_PLAYER_HISTORY_PATH=/app/data/player_history.csv
STEAM_APPID=730
STEAM_REQUEST_TIMEOUT_SECONDS=5
