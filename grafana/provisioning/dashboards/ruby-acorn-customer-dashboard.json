{
  "uid": "ruby-acorn-customer",
  "title": "Ruby Acorn Customer Costs",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "tags": [
    "ruby-acorn",
    "customer",
    "cost"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Operational overview",
      "type": "link",
      "url": "/d/ruby-acorn-autoscaler/ruby-acorn-autoscaler",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Scaling dashboard",
      "type": "link",
      "url": "/d/ruby-acorn-scaling/ruby-acorn-scaling",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "game",
        "label": "Game",
        "type": "query",
        "datasource": "Prometheus",
        "query": {
          "query": "label_values(running_instances{job=\"autoscaler\"}, appid)",
          "refId": "GameVariable"
        },
        "definition": "label_values(running_instances{job=\"autoscaler\"}, appid)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Current VM count",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(running_instances{job=\"autoscaler\",appid=~\"${game:regex}\"})",
          "legendFormat": "Selected games",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Estimated cost (EUR/hour)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 3,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(dynamic_cost{job=\"autoscaler\",appid=~\"${game:regex}\"})",
          "legendFormat": "Selected games",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Fixed baseline (EUR/hour)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 3,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(fixed_baseline_cost{job=\"autoscaler\",appid=~\"${game:regex}\"})",
          "legendFormat": "Selected games",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Estimated savings (EUR/hour)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 3,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(savings{job=\"autoscaler\",appid=~\"${game:regex}\"})",
          "legendFormat": "Selected games",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Below strategy target",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "At or above target",
                  "color": "green"
                },
                "1": {
                  "text": "Below target",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "max(running_instances{job=\"autoscaler\",appid=~\"${game:regex}\"} < bool desired_instances{job=\"autoscaler\",appid=~\"${game:regex}\"}) and (count(running_instances{job=\"autoscaler\",appid=~\"${game:regex}\"}) == count(desired_instances{job=\"autoscaler\",appid=~\"${game:regex}\"}))",
          "legendFormat": "Selected games",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "title": "VMs missing versus strategy target",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(clamp_min(desired_instances{job=\"autoscaler\",appid=~\"${game:regex}\"} - running_instances{job=\"autoscaler\",appid=~\"${game:regex}\"}, 0)) and (count(running_instances{job=\"autoscaler\",appid=~\"${game:regex}\"}) == count(desired_instances{job=\"autoscaler\",appid=~\"${game:regex}\"}))",
          "legendFormat": "Selected games",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Oldest decision (seconds)",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "max(time() - last_decision_timestamp_seconds{job=\"autoscaler\",appid=~\"${game:regex}\"})",
          "legendFormat": "Selected games",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Estimated cost versus fixed baseline (EUR/hour)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 3,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(dynamic_cost{job=\"autoscaler\",appid=~\"${game:regex}\"})",
          "legendFormat": "Dynamic cost",
          "refId": "A",
          "range": true
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(fixed_baseline_cost{job=\"autoscaler\",appid=~\"${game:regex}\"})",
          "legendFormat": "Fixed baseline",
          "refId": "B",
          "range": true
        }
      ]
    },
