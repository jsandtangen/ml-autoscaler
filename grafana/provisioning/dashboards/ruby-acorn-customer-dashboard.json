    {
      "id": 11,
      "title": "Selected strategy by game",
      "type": "table",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "strategy{job=\"autoscaler\",appid=~\"${game:regex}\"} == 1",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "appid": "Game",
              "name": "Strategy"
