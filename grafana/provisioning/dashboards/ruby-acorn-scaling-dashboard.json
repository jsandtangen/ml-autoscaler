    {
      "id": 7,
      "title": "Scale-up and scale-down events per interval",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "increase(scale_up_events_total{appid=~\"${game:regex}\"}[$__rate_interval])",
          "legendFormat": "scale up {{appid}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "increase(scale_down_events_total{appid=~\"${game:regex}\"}[$__rate_interval])",
          "legendFormat": "scale down {{appid}}",
          "refId": "B",
          "range": true
        }
      ]
